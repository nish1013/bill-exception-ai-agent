    "@mui/x-data-grid": "7.29.13",
    "graphql": "16.14.2",
    "oidc-client-ts": "3.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "7.18.4",
    "zod": "3.25.76"
